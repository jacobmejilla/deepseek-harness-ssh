{
  "name": "@deepseek-ai/dsh-ssh-hosts",
  "description": "SSH host discovery, remote helper provisioning, and remote workspace launch for the DeepSeek Harness",
  "version": "0.2.2-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jacobmejilla/deepseek-harness-ssh.git",
    "directory": "packages/ssh/ssh-hosts"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-client-connection": "workspace:*",
    "@deepseek-ai/dsh-host-webserver": "workspace:*"
  },
  "dependencies": {
    "@deepseek-ai/dsh-home-paths": "workspace:*",
    "@deepseek-ai/schemastery": "workspace:~",
    "tar": "^7.5.22",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-client-connection": "workspace:*",
    "@deepseek-ai/dsh-host-webserver": "workspace:*"
  }
}
